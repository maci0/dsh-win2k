{
  "name": "dsh-win2k",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Windows 2000 theme for DeepSeek Harness: a ctx.theme registration that appears in the Appearance row beside light/dark/system, with period chrome for the parts a token cannot spell.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
